# Open WebUI → VaultRun local gateway
# In Admin → Connections → OpenAI, or via env when running Open WebUI:

OPENAI_API_BASE_URL=http://127.0.0.1:8091/v1
OPENAI_API_KEY=replace-with-LOCAL_GATEWAY_AUTH_TOKEN

# Optional: pin a conversation/session from custom headers if your build supports them.
# X-VaultRun-Conversation-Id: open-webui-user-1
